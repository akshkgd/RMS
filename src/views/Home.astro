---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SectionTitle from '../components/SectionTitle.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import EventsGrid from '../components/EventsGrid.astro';
import { exists } from '../lib/img';
import { site, videos } from '../data/site';
import { content, lp, type Lang } from '../data/i18n';
const { lang = 'hi' } = Astro.props as { lang?: Lang };
const c = content[lang];
const { intro, book, gurukulInfo: gurukul, events, ui } = c;
const dv = lang === 'hi' ? 'deva' : '';
// Landing page: the scholarly-profile lines continue the last biography paragraph (no separate section)
const merged = [...intro.paras.slice(0, -1), [intro.paras[intro.paras.length - 1], ...intro.scholar].join(' ')];
const hasVideo = exists('videos/intro.mp4');
const hasPoster = exists('images/intro-poster.jpg');
const hasGurukulPhoto = exists('images/gurukul.jpg');
---
<Base lang={lang}>
  <div class="stock" id="stock" role="alert" hidden>
    <div class="stockin">
      <div>
        <strong>{book.soldTitle}</strong>
        <p>{book.soldText} <a href={site.instagram} target="_blank" rel="noopener">{book.soldLink}</a></p>
      </div>
      <button type="button" id="stockx" aria-label={book.close}>✕</button>
    </div>
  </div>
  <!-- 1. Hero -->
  <section class="hero">
    <HeroCarousel slides={[{src:'/images/hero.jpg',alt:c.name},{src:'/images/hero-2.jpg',alt:c.name,pos:'30% 40%',mobile:'/images/hero-2-mobile.jpg',mpos:'50% 80%'}]} />
  </section>

  <!-- 2. Intro -->
  <section class="aboutbg" id="about">
    <div class:list={[hasVideo ? 'wrap two' : 'wrap solo']}>
      {hasVideo && (
        <div class="vid">
          <video controls preload="metadata" playsinline poster={hasPoster ? '/images/intro-poster.jpg' : undefined}><source src="/videos/intro.mp4" type="video/mp4" /></video>
        </div>
      )}
      <div>
        <SectionTitle title={intro.heading} />
        {merged.map(t => <p class:list={[dv,"ipara","read"]}>{t}</p>)}
        <p class="introbtn"><a class="btn" href={lp(lang,'/about')}>{ui.aboutGurukul}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a></p>
      </div>
    </div>
  </section>

  <!-- 3. Upcoming events -->
  <section class="maroon events" id="events">
    <div class="wrap">
      <SectionTitle title={ui.upcoming} center orn light />
      <EventsGrid events={events} lang={lang} />
    </div>
  </section>

  <!-- 4. Gurukul -->
  <section class="cream" id="prakalp">
    <div class:list={[hasGurukulPhoto ? 'wrap two gk' : 'wrap solo']}>
      {hasGurukulPhoto && <div class="gkimg"><Photo file="gurukul.jpg" label={c.gurukul} ratio="4/3" arch={false} /><a class="btn gkon" href={lp(lang,'/gurukul')}>{ui.aboutGurukul}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a></div>}
      <div class="gktxt">
        <SectionTitle title={c.gurukul} />
        <p class:list={[dv,"gkp","read"]}>{gurukul.text}</p>
        <div class="stats">{c.stats.map(([n, l]) => <div class="stat"><b>{n}</b><span>{l}</span></div>)}</div>
        <p class:list={['gkbtn', { mob: hasGurukulPhoto }]}><a class="btn" href={lp(lang,'/gurukul')}>{ui.aboutGurukul}</a></p>
      </div>
    </div>
  </section>

  <!-- 5. Book -->
  <section class="sand">
    <div class="wrap two">
      <div class="cover"><img src="/images/book.png" alt={book.alt} loading="lazy" /></div>
      <div>
        <SectionTitle title={book.title} sub={book.subtitle} />
        <p class="brole">{book.by} {book.author}</p>
        {book.text.map(t => <p class="read" style="margin-top:1rem">{t}</p>)}
        <p style="margin-top:1.5rem"><button type="button" class="btn" id="order">{book.cta}</button></p>
      </div>
    </div>
  </section>

  <!-- 6. Recent videos -->
  <section class="cream">
    <div class="wrap center">
      <SectionTitle title={ui.recentVideos} center orn />
      <div class="grid vgrid">
        {videos.map(v => (
          <div class="yt">
            <iframe src={`https://www.youtube.com/embed/${v.id}`} title={v.title} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          </div>
        ))}
      </div>
      <p style="margin-top:2rem"><a class="btn" href={site.youtube} target="_blank" rel="noopener">{ui.moreVideos}</a></p>
    </div>
  </section>
</Base>
<script>
  const box = document.getElementById('stock')!;
  let timer: number;
  const hide = () => { box.hidden = true; };
  document.getElementById('order')?.addEventListener('click', () => {
    box.hidden = false;
    clearTimeout(timer);
    timer = window.setTimeout(hide, 12000);
  });
  document.getElementById('stockx')?.addEventListener('click', hide);
</script>
<style>
.stock{position:fixed;top:0;left:0;right:0;z-index:40;background:var(--peach-d);color:#2b1018;box-shadow:0 6px 20px #0004;border-bottom:3px solid var(--maroon)}
.stock[hidden]{display:none}
.stock:not([hidden]){animation:drop .3s ease-out}
@keyframes drop{from{transform:translateY(-100%)}to{transform:none}}
.stockin{width:min(1000px,100% - 2rem);margin-inline:auto;padding:1rem 0;display:flex;gap:1rem;align-items:flex-start;justify-content:space-between}
.stockin strong{font-family:var(--jos);font-size:1.1rem;color:var(--maroon-d)}
.stockin p{margin-top:.2rem;font-size:.95rem;line-height:1.6}
.stockin a{color:var(--maroon);font-weight:600}
.stockin button{background:none;border:0;font-size:1.2rem;cursor:pointer;color:var(--maroon-d);padding:.2rem .4rem}
.hero{padding:0;height:100vh;min-height:520px;overflow:hidden;background:var(--maroon-d)}
.hero :global(.ph){object-position:20% 40%}
@media(max-width:768px){
  .hero{height:min(88svh,125vw);min-height:420px}
  .hero :global(.ph){object-position:12% 40%}
}
.aboutbg{position:relative;isolation:isolate;background:#f3dcc4;color:#2b1018;padding:6rem 0}
.aboutbg::before{content:'';position:absolute;inset:0;z-index:-1;background:url(/images/about-bg.webp) center/cover no-repeat;filter:sepia(.55) saturate(.8) hue-rotate(-6deg)}
.vid{width:100%;aspect-ratio:16/9;background:#000}
.vid video{display:block;width:100%;height:100%;object-fit:cover}
.introbtn{margin-top:.6rem;display:flex}
.introbtn .btn{display:inline-flex;align-items:center;gap:.5rem}
.introbtn svg{width:1.05rem;height:1.05rem;flex:none;position:relative}
:global(html[lang=hi]) .introbtn svg{top:-3px}
.ipara{margin-bottom:1.3rem}
.events{padding:110px 0 80px;position:relative;overflow:hidden;
  background:
    radial-gradient(ellipse 70% 45% at 50% 0%,#a63a4f55,transparent 70%),
    radial-gradient(ellipse 80% 60% at 50% 110%,#00000066,transparent 70%),
    linear-gradient(180deg,#6b1a32 0%,#4a0f22 55%,#36091a 100%)}
.events::before,.events::after{content:'';position:absolute;width:640px;height:640px;background:url(/images/mandala.svg) center/contain no-repeat;opacity:.14;pointer-events:none}
.events::before{left:-260px;top:-120px}
.events::after{right:-260px;bottom:-160px}
.events .wrap{position:relative;z-index:1}
.gkp{margin-bottom:1.8rem}
/* Gurukul: photo and text column share the same top and bottom edges */
.gk{align-items:stretch}
.gkimg{position:relative;min-height:480px}
.gk{padding-block:2.5rem}
.gkimg :global(.ph){position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto !important;object-fit:cover}
.gktxt{display:flex;flex-direction:column}
.gktxt :global(.st){margin-bottom:1.2rem}
.gktxt :global(h2){margin-top:.05em}
:global(html[lang=en]) .gktxt :global(h2){margin-top:-.22em}
.gkbtn{padding-top:1.6rem;display:flex}
.gkbtn.mob{display:none}
.gkimg::after{content:'';position:absolute;left:0;right:0;bottom:0;height:45%;background:linear-gradient(transparent,#2b101899);pointer-events:none}
.gkon{display:inline-flex;align-items:center;gap:.5rem;position:absolute;left:1.4rem;bottom:1.4rem;z-index:2;box-shadow:0 6px 18px #0006;transition:transform .25s,background .25s}
.gkon svg{width:1.05rem;height:1.05rem;flex:none;transition:transform .25s;position:relative;top:0}
:global(html[lang=hi]) .gkon svg{top:-3px}
.gkon:hover{transform:translateY(-3px);background:var(--maroon-d)}
.gkon:hover svg{transform:translate(2px,-2px)}
.gktxt .stats{margin-top:auto}
/* Mobile order: heading → photo → tags → description → button */
@media(max-width:800px){
  .gk{display:flex;flex-direction:column;gap:0;padding-block:0}
  .gktxt{display:contents}
  .gktxt :global(.st){order:1;margin-bottom:1.2rem}
  .gkimg{order:2;min-height:0;aspect-ratio:4/3;margin-bottom:1.4rem}
  .gkimg::after,.gkon{display:none}
  .gktxt .stats{order:3;margin:0 0 1.6rem}
  .gktxt .gkp{order:4;margin-bottom:0}
  .gkbtn.mob{display:flex;order:5;padding-top:1.6rem}
}
.stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:1.8rem;background:#fff;border-radius:14px;box-shadow:0 6px 22px #5a142818;overflow:hidden}
.stat{padding:1.1rem .6rem;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:.4rem}
.stat + .stat{border-left:1px solid #ecdcc4}
.stat b{font-family:var(--jos);font-weight:500;font-size:1.45rem;color:var(--maroon);line-height:1.2;height:2.4rem;display:flex;align-items:center;justify-content:center;letter-spacing:0}
.stat span{font-family:var(--body);font-weight:500;font-size:.85rem;color:#6b5a50;line-height:1.4;letter-spacing:.01em}
:global(html[lang=hi]) .stat b{font-family:'Noto Sans Devanagari','DM Sans',sans-serif;font-size:1.35rem}
:global(html[lang=hi]) .stat span{font-family:'Noto Sans Devanagari','DM Sans',sans-serif;font-size:.82rem}
@media(max-width:600px){.stat b,:global(html[lang=hi]) .stat b{font-size:1.05rem;height:2rem}.stat span,:global(html[lang=hi]) .stat span{font-size:.72rem}}
.gkp{margin-bottom:1.8rem}
.cover{width:min(320px,100%);margin-inline:auto}
.cover img{display:block;width:100%;height:auto;filter:drop-shadow(0 18px 14px #3a0f1c55) drop-shadow(0 4px 4px #3a0f1c33)}
.bsub{color:var(--maroon);margin-top:.2rem}
.brole{font-size:.95rem;color:#6b5a50;margin-top:-1rem}
.vgrid{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.yt{aspect-ratio:16/9;background:#000;border:6px solid #fff;box-shadow:0 10px 30px #5a142833}
.yt iframe{width:100%;height:100%;border:0;display:block}
</style>
