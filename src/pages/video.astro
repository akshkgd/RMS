---
import Base from '../layouts/Base.astro';
import { site, videos } from '../data/site';
---
<Base title="Video">
  <div class="page-hero"><div class="wrap"><h1>Video</h1></div></div>
  <section class="cream"><div class="wrap center">
    <div class="grid vgrid">
      {videos.map(v => (
        <div class="yt"><iframe src={`https://www.youtube.com/embed/${v.id}`} title={v.title} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
      ))}
    </div>
    <p style="margin-top:2rem"><a class="btn" href={site.youtube} target="_blank" rel="noopener">All videos on YouTube</a></p>
  </div></section>
</Base>
<style>
.vgrid{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.yt{aspect-ratio:16/9;background:#000;border:6px solid #fff;box-shadow:0 10px 30px #5a142833}
.yt iframe{width:100%;height:100%;border:0;display:block}
</style>
