---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { exists } from '../lib/img';
import { site, intro, gurukul } from '../data/site';
const hasPortrait = exists('images/portrait.jpg');
---
<Base title="About us" solidNav>

  <section class="cream">
    <div class:list={[hasPortrait ? 'wrap two' : 'wrap solo']}>
      {hasPortrait && <Photo file="portrait.jpg" label={site.name} arch={false} />}
      <div>
        <SectionTitle title={`${site.name} Ji`} />
        <p class="deva guru"><strong>{intro.guruTitle}</strong> {intro.lead}</p>
        {intro.paras.map(t => <p class="deva para">{t}</p>)}
      </div>
    </div>
  </section>

  <section class="sand">
    <div class="wrap solo">
      <SectionTitle title={site.gurukul} />
      <p class="deva para">{gurukul.text}</p>
      <ul class="deva list">{gurukul.subjects.map(x => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="cream">
    <div class="wrap solo">
      <SectionTitle title="Guru Parampara" />
      <p class="deva para">{site.name} के गुरु, {intro.guruTitle}।</p>
      <p><a class="btn" href={site.guruInstagram} target="_blank" rel="noopener">Follow Maharaj Ji on Instagram</a></p>
    </div>
  </section>
</Base>
<style>
.guru{margin-bottom:1.2rem;line-height:1.8}
.guru strong{color:var(--maroon-d);font-weight:400}
.para{margin-bottom:1.2rem;line-height:1.9}
</style>
