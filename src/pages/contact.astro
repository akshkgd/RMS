---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { site } from '../data/site';
const wa = site.whatsapp ? `https://wa.me/${site.whatsapp}` : '';
const tel = site.phone ? `tel:${site.phone.replace(/\s/g, '')}` : '';
---
<Base title="Contact">
  <div class="page-hero"><div class="wrap"><h1>Contact</h1></div></div>
  <section class="cream">
    <div class:list={[site.formEndpoint ? 'wrap two' : 'wrap solo']}>
      <div>
        <SectionTitle title="Get in touch" />
        <p class="deva intro">प्रवेश, कथा या पुस्तक के बारे में जानने के लिए नीचे दिए माध्यमों से सम्पर्क करें।</p>
        {site.address && <p class="addr">{site.address}</p>}
        <div class="actions">
          {tel && <a class="btn" href={tel}>Call {site.phone}</a>}
          {wa && <a class="btn" href={wa} target="_blank" rel="noopener">WhatsApp</a>}
          {site.email && <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>}
          <a class="btn" href={site.instagram} target="_blank" rel="noopener">Message on Instagram</a>
        </div>
      </div>
      {site.formEndpoint && (
        <form action={site.formEndpoint} method="post">
          <input name="name" placeholder="Your name" required />
          <input name="email" type="email" placeholder="Email" required />
          <textarea name="message" rows="5" placeholder="Message" required></textarea>
          <button class="btn" type="submit">Send</button>
        </form>
      )}
    </div>
  </section>
</Base>
<style>
.intro{line-height:1.9;margin-bottom:1.2rem}
.addr{margin-bottom:1.2rem}
.actions{display:flex;flex-wrap:wrap;gap:.8rem}
form{display:grid;gap:1rem}
input,textarea{font:inherit;padding:.8rem 1rem;border:1px solid #d8c8ab;background:#fff}
button{justify-self:start}
</style>
