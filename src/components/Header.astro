---
import { content, lp } from '../data/i18n';
const { solid = false, lang = 'hi' } = Astro.props;
const c = content[lang as 'hi'|'en'];
const hi = content.hi; // brand is always shown in Hindi, in both languages
---
<header class:list={{ solid }}>
  <div class="bar">
    <a class="brand" href={lp(lang,'/')}><img class="logo" src="/images/logo.png" alt="" width="56" height="56" /><span class="txt"><span class="nm deva">{hi.name}</span><small class="deva">(संस्थापक, {hi.gurukul})</small></span></a>
    <input type="checkbox" id="t" hidden />
    <label for="t" class="burger" aria-label={c.ui.menu}><b></b><b></b><b></b></label>
    <nav aria-label="Main">{c.nav.map(n => <a href={lp(lang,n.href)}>{n.label}</a>)}</nav>
  </div>
</header>
<style>
header{position:absolute;left:0;right:0;top:0;z-index:5}
header.solid{position:relative;background:var(--maroon-d)}
header.solid::before{display:none}
header::before{content:'';position:absolute;inset:0 0 -50px;background:linear-gradient(#000000a0,transparent);z-index:-1;pointer-events:none}
.bar{display:flex;align-items:center;justify-content:space-between;padding:1rem 2rem}
.brand{text-decoration:none;color:#fff;display:flex;align-items:center;gap:.8rem;line-height:1.2}
.txt{display:flex;flex-direction:column}
.logo{width:52px;height:52px;object-fit:contain;flex:none;transform:scale(1.3);margin:0 .3rem 0 .4rem}
.brand .nm{font-size:1.2rem}
.brand .deva{font-family:var(--deva)}
.brand small{word-spacing:normal;color:var(--peach-d);letter-spacing:0;text-transform:none;font-size:.8rem}
.burger{cursor:pointer;display:grid;gap:6px;width:36px}
.burger b{display:block;height:2px;background:#fff;box-shadow:0 1px 4px #0008}
.burger b:nth-child(2){width:70%;justify-self:end}
nav{display:none;position:absolute;top:100%;right:2rem;background:var(--maroon-d);min-width:220px;padding:.5rem 1.2rem}
nav a{display:block;color:#fff;text-decoration:none;font-family:var(--jos);font-weight:400;padding:.7rem 0;border-bottom:1px solid #fff2}
nav a:hover{color:var(--peach-d)}
#t:checked ~ nav{display:block}
@media(min-width:992px){
  .burger{display:none}
  #t:checked ~ nav,nav{display:flex}
  nav{display:flex;position:static;background:none;min-width:0;padding:0;gap:2rem}
  nav a{border:0;padding:.3rem 0}
}
@media(max-width:600px){.bar{padding:1rem}nav{right:1rem}.logo{width:40px;height:40px;margin:0 .3rem 0 .4rem}.brand{gap:.5rem}.brand .nm{font-size:1rem}}
</style>
<script>
  const t = document.getElementById('t') as HTMLInputElement | null;
  document.querySelectorAll('header nav a').forEach(a => a.addEventListener('click', () => { if (t) t.checked = false; }));
</script>
