---
const { title, sub, center = false, orn = false, light = false } = Astro.props;
---
<div class:list={['st', { center, light }]}>
  <h2>{title}</h2>
  {sub && <p class="sub">{sub}</p>}
  {orn && <div class="orn"><i></i><b>❖</b><i></i></div>}
</div>
<style>
.st{margin-bottom:1.6rem}
.st.center{text-align:center}
h2{font-size:clamp(1.8rem,3.5vw,2.5rem);color:var(--maroon-d);line-height:1.25}
.sub{color:var(--maroon);margin-top:.3rem}
.orn{display:flex;align-items:center;justify-content:center;gap:14px;color:var(--maroon);margin-top:.9rem}
.orn i{display:block;width:110px;height:1px;background:linear-gradient(90deg,transparent,currentColor)}
.orn i:last-child{transform:scaleX(-1)}
.light h2{color:#fff}
.light .orn{color:var(--peach-d)}
</style>
