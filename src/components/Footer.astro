---
import { site } from '../data/site';
import { content, lp } from '../data/i18n';
const { lang = 'hi' } = Astro.props;
const c = content[lang as 'hi'|'en'];
const real = (v: string) => !!v;
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap top">
    <div class="brand">
      <img class="flogo" src="/images/footer-vidyapeetham.png" alt={c.gurukul} loading="lazy" />
      <span class:list={['name',{deva:lang==='hi'}]}>{c.name}</span>
      <small>({lang === 'hi' ? 'संस्थापक' : 'Founder'}, {c.gurukul})</small>
      <p>{c.bio}.</p>
      <p class="loc">📍 {c.location}</p>
    </div>

    <nav class="col" aria-label="Footer">
      <h4>{c.ui.explore}</h4>
      {c.nav.map(n => <a href={lp(lang,n.href)}>{n.label}</a>)}
    </nav>

    <div class="col">
      <h4>{c.ui.connect}</h4>
      <div class="socrow">
      <a class="sl" href={site.youtube} target="_blank" rel="noopener" aria-label="YouTube"><b><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2C.5 9 .5 12 .5 12s0 3 .5 4.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.5-1.8.5-4.8.5-4.8s0-3-.5-4.8ZM9.8 15.4V8.6L15.7 12l-5.9 3.4Z"/></svg></b><span>{c.ui.ytName}</span></a>
      <a class="sl" href={site.instagram} target="_blank" rel="noopener" aria-label={c.ui.igGurukul}><b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></b><span>{c.ui.igGurukul}</span></a>
      <a class="sl" href={site.guruInstagram} target="_blank" rel="noopener" aria-label={c.ui.igGuru}><b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></b><span>{c.ui.igGuru}</span></a>
      </div>
      {real(site.email) && <a href={`mailto:${site.email}`}>{site.email}</a>}
    </div>
  </div>
  <div class="bar">
    <div class="wrap barin">
      <span class="deva sita">॥ श्री सीताराम ॥</span>
      <span>© {year} {c.name}. {c.ui.rights}</span>
    </div>
  </div>
</footer>
<style>
footer{background:linear-gradient(180deg,#5a1428,#43101e);color:#f1e2d2;border-top:4px solid var(--peach-d)}
.top{display:grid;grid-template-columns:1.6fr 1fr 1.2fr;gap:3rem;padding:4rem 0 3rem}
.brand{display:flex;flex-direction:column;gap:.5rem}
.name{font-family:var(--head);font-size:1.5rem;color:var(--peach-d);line-height:1.2}
:global(html[lang=en]) .name{font-size:1.75rem}
.brand small{font-family:var(--deva);word-spacing:normal;letter-spacing:0;text-transform:none;font-size:.8rem;line-height:1.2;color:#e6cdb5;margin-top:-.5rem}
.brand p{max-width:34ch;font-size:.95rem;color:#e9d6c3}
.flogo{width:110px;height:110px;object-fit:contain;display:block;margin-bottom:.4rem}
@media(max-width:600px){.flogo{width:92px;height:92px}}
.brand .loc{margin-top:.4rem}
.socrow{display:flex;flex-direction:column;gap:.7rem}
.col a.sl{display:flex;align-items:center;gap:.7rem}
.sl b{width:2.2rem;height:2.2rem;flex:none;border-radius:50%;border:1px solid #ffffff40;display:grid;place-items:center;transition:background .25s,color .25s,border-color .25s}
.sl span{line-height:1.3}
:global(html[lang=hi]) .sl span{position:relative;top:2px}
.sl svg{width:1.05rem;height:1.05rem}
.col a.sl:hover b{background:var(--peach-d);color:#43101e;border-color:var(--peach-d)}
.col{display:flex;flex-direction:column;gap:.55rem}
h4{color:#fff;font-family:var(--jos);font-size:1.1rem;margin-bottom:.4rem;padding-bottom:.5rem;border-bottom:1px solid #ffffff2e;width:fit-content;padding-right:2rem}
.col a{color:#f1e2d2;text-decoration:none;font-size:.95rem;width:fit-content}
.col a:hover{color:var(--peach-d)}
.bar{border-top:1px solid #ffffff1f;background:#36091a}
.barin{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:1rem 0;font-size:.85rem;color:#d9c3ad}
.barin .deva{color:var(--peach-d)}
@media(max-width:800px){.top{grid-template-columns:1fr;gap:2rem;padding:3rem 0 2rem}.barin{flex-direction:column;align-items:center;text-align:center}}
</style>
