---
const { slides } = Astro.props as { slides: { src: string; alt: string; pos?: string; mobile?: string; mpos?: string }[] };
---
<div class="hc" id="hc" aria-roledescription="carousel">
  {slides.map((s, i) => (
    <picture style="display:contents">
      {s.mobile && <source media="(max-width:768px)" srcset={s.mobile} />}
      <img class="sl" src={s.src} alt={s.alt} style={`--pos:${s.pos ?? '20% 40%'};--mpos:${s.mpos ?? '12% 40%'};opacity:${i === 0 ? 1 : 0}`} loading={i === 0 ? 'eager' : 'lazy'} draggable="false" />
    </picture>
  ))}
  <div class="dots" role="tablist">
    {slides.map((_, i) => <button type="button" class:list={['dot', { on: i === 0 }]} data-i={i} aria-label={`Slide ${i + 1}`}></button>)}
  </div>
</div>
<style>
.hc{position:relative;width:100%;height:100%;overflow:hidden;touch-action:pan-y}
.sl{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--pos);will-change:opacity,transform;user-select:none}
.dots{position:absolute;left:50%;bottom:1.4rem;transform:translateX(-50%);display:flex;gap:.55rem;z-index:2}
.dot{width:.6rem;height:.6rem;border-radius:99px;border:0;padding:0;background:#ffffff80;cursor:pointer}
.dot.on{background:#fff}
@media(max-width:768px){.sl{object-position:var(--mpos,12% 40%)}}
</style>
<script>
  import { animate } from 'motion';
  const root = document.getElementById('hc')!;
  const slides = [...root.querySelectorAll<HTMLElement>('.sl')];
  const dots = [...root.querySelectorAll<HTMLElement>('.dot')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cur = 0, timer = 0;
  const zoom = (el: HTMLElement) => { if (!reduce) animate(el, { scale: [1.0, 1.08] }, { duration: 9, ease: 'linear' }); };
  zoom(slides[0]);
  function go(n: number) {
    n = (n + slides.length) % slides.length;
    if (n === cur) return;
    const from = slides[cur], to = slides[n];
    to.style.zIndex = '1'; from.style.zIndex = '0';
    zoom(to);
    animate(to, { opacity: [0, 1] }, { duration: reduce ? 0 : 1.2, ease: 'easeInOut' }).finished.then(() => { from.style.opacity = '0'; });
    dots[cur].classList.remove('on'); dots[n].classList.add('on');
    cur = n;
  }
  const start = () => { stop(); timer = window.setInterval(() => go(cur + 1), 6000); };
  const stop = () => clearInterval(timer);
  start();
  dots.forEach(d => d.addEventListener('click', () => { go(+d.dataset.i!); start(); }));
  let x0 = 0;
  root.addEventListener('pointerdown', e => { x0 = e.clientX; });
  root.addEventListener('pointerup', e => { const d = e.clientX - x0; if (Math.abs(d) > 50) { go(cur + (d < 0 ? 1 : -1)); start(); } });
</script>
